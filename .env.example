# Copy to apps/api/.env for local dev. On Hostinger, set these in the Node.js app's Environment variables.
NODE_ENV=development
PORT=3000
# MariaDB connection. URL-encode special characters in the password.
DATABASE_URL="mysql://andy_user:change_me@localhost:3306/andy_dev"
# Set to true on Hostinger so each deploy applies new database migrations during the build.
RUN_MIGRATIONS=false
# Public site URL (used in email links). No trailing slash.
APP_URL=http://localhost:5173

# Secrets: generate each with `openssl rand -hex 32`. Never reuse between staging and production.
CRON_SECRET=replace_with_long_random_string
JWT_SECRET=replace_with_another_long_random_string

# The first account with this email to confirm its address becomes Super Admin (only while none exists).
BOOTSTRAP_ADMIN_EMAIL=

# Email. "log" writes emails to the app log instead of sending (fine for local dev).
MAIL_TRANSPORT=log
MAIL_FROM="Andy Auto Club <no-reply@example.com>"
# For Hostinger email: SMTP_HOST=smtp.hostinger.com, SMTP_PORT=465, SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
