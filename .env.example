# Copy to apps/api/.env for local dev. On Hostinger, set these in hPanel > Node.js app > Environment variables.
NODE_ENV=development
PORT=3000
# MariaDB connection. Hostinger: hPanel > Databases > MySQL Databases (host is usually localhost).
DATABASE_URL="mysql://andy_user:change_me@localhost:3306/andy_dev"
# Secret for the HTTP cron fallback (/internal/cron/:job). Generate: openssl rand -hex 32
CRON_SECRET=replace_with_long_random_string
# Public site URL (used for CORS and links in emails)
APP_URL=http://localhost:5173
