{
  "name": "andy-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "engines": { "node": ">=20.19" },
  "scripts": {
    "dev": "npm run dev -w @andy/api & npm run dev -w @andy/web",
    "build": "npm run build -w @andy/shared && npm run build -w @andy/web && npm run build -w @andy/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run typecheck",
    "bundle:hostinger": "npm run build && node scripts/bundle-hostinger.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
