// Phase 0 schema: only the system tables needed to prove Prisma + MariaDB + cron on Hostinger.
// Feature tables are added module by module (see PROJECT_PLAN.md section 7).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

/// Key/value platform settings. Money-related settings are versioned via SettingHistory (later phase).
model Setting {
  key         String   @id @db.VarChar(100)
  value       Json
  updatedById BigInt?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Append-only log of admin and money actions.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    BigInt?
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(60)
  entityId   String?  @db.VarChar(60)
  before     Json?
  after      Json?
  ip         String?  @db.VarChar(45)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

enum JobRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

/// One row per cron job run. Used for visibility and to stop overlapping runs.
model JobRun {
  id         BigInt       @id @default(autoincrement())
  job        String       @db.VarChar(60)
  status     JobRunStatus
  trigger    String       @db.VarChar(20) // "cli" or "http"
  startedAt  DateTime     @default(now())
  finishedAt DateTime?
  processed  Int          @default(0)
  error      String?      @db.Text

  @@index([job, startedAt])
  @@index([job, status])
}

// ───────────────────────── Identity & access (Phase 1) ─────────────────────────

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

model User {
  id              BigInt     @id @default(autoincrement())
  publicId        String     @unique @db.VarChar(24)
  email           String     @unique @db.VarChar(191)
  phone           String?    @db.VarChar(32)
  fullName        String     @db.VarChar(150)
  passwordHash    String     @db.VarChar(100)
  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  roles              UserRole[]
  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]

  @@index([status])
  @@index([createdAt])
}

enum RoleScope {
  PLATFORM
  MERCHANT
}

model Role {
  id          Int       @id @default(autoincrement())
  key         String    @unique @db.VarChar(60)
  name        String    @db.VarChar(100)
  description String?   @db.VarChar(255)
  scope       RoleScope @default(PLATFORM)
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          Int    @id @default(autoincrement())
  key         String @unique @db.VarChar(100)
  description String @db.VarChar(255)

  roles RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  userId      BigInt
  roleId      Int
  grantedById BigInt?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
}

/// Refresh tokens are stored hashed. `family` groups a rotation chain so reuse of an old token revokes the chain.
model RefreshToken {
  id         BigInt    @id @default(autoincrement())
  userId     BigInt
  family     String    @db.VarChar(40)
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedAt DateTime?
  userAgent  String?   @db.VarChar(255)
  ip         String?   @db.VarChar(45)
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@index([expiresAt])
}

enum VerificationTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model VerificationToken {
  id        BigInt                @id @default(autoincrement())
  userId    BigInt
  type      VerificationTokenType
  tokenHash String                @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// ───────────────────────── Notifications (Phase 1) ─────────────────────────

enum EmailStatus {
  QUEUED
  SENDING
  SENT
  FAILED
}

/// Outbox: emails are queued inside business transactions and sent by the send-emails cron job.
model EmailOutbox {
  id          BigInt      @id @default(autoincrement())
  toEmail     String      @db.VarChar(191)
  templateKey String      @db.VarChar(60)
  subject     String      @db.VarChar(255)
  bodyHtml    String      @db.Text
  bodyText    String      @db.Text
  status      EmailStatus @default(QUEUED)
  attempts    Int         @default(0)
  lastError   String?     @db.Text
  sendAfter   DateTime    @default(now())
  sentAt      DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status, sendAfter])
  @@index([toEmail])
}

// ───────────────────────── Membership (Phase 2) ─────────────────────────

/// Price history is kept by creating a new plan and deactivating the old one; never edit priceSen in place.
model MembershipPlan {
  id             Int      @id @default(autoincrement())
  code           String   @unique @db.VarChar(40)
  name           String   @db.VarChar(100)
  priceSen       Int
  durationMonths Int
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships Membership[]
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  REFUNDED
}

model Membership {
  id            BigInt           @id @default(autoincrement())
  userId        BigInt
  planId        Int
  status        MembershipStatus
  startAt       DateTime
  endAt         DateTime
  sourceOrderId BigInt?          @unique
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  plan      MembershipPlan       @relation(fields: [planId], references: [id], onDelete: Restrict)
  events    MembershipEvent[]
  reminders MembershipReminder[]

  @@index([userId, status])
  @@index([status, endAt])
}

enum MembershipEventType {
  ACTIVATED
  RENEWED
  EXPIRED
  CANCELLED
  REFUNDED
  EXTENDED_BY_ADMIN
}

model MembershipEvent {
  id           BigInt              @id @default(autoincrement())
  membershipId BigInt
  type         MembershipEventType
  actorId      BigInt?
  note         String?             @db.VarChar(500)
  data         Json?
  createdAt    DateTime            @default(now())

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Restrict)

  @@index([membershipId])
}

// ───────────────────────── Orders & payments (Phase 2) ─────────────────────────

enum OrderType {
  MEMBERSHIP
  MARKETPLACE
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  EXPIRED
  REFUNDED
}

model Order {
  id          BigInt      @id @default(autoincrement())
  publicNo    String      @unique @db.VarChar(24)
  userId      BigInt
  type        OrderType
  status      OrderStatus @default(PENDING_PAYMENT)
  subtotalSen Int
  discountSen Int         @default(0)
  taxSen      Int         @default(0)
  totalSen    Int
  currency    String      @default("MYR") @db.Char(3)
  paidAt      DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items    OrderItem[]
  payments Payment[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

enum OrderItemType {
  MEMBERSHIP
  LISTING
  VOUCHER
}

model OrderItem {
  id            BigInt        @id @default(autoincrement())
  orderId       BigInt
  itemType      OrderItemType
  refId         String        @db.VarChar(40)
  titleSnapshot String        @db.VarChar(200)
  unitPriceSen  Int
  qty           Int
  lineTotalSen  Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

enum PaymentStatus {
  CREATED
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

model Payment {
  id          BigInt        @id @default(autoincrement())
  orderId     BigInt
  provider    String        @db.VarChar(30)
  providerRef String?       @db.VarChar(100)
  amountSen   Int
  currency    String        @default("MYR") @db.Char(3)
  status      PaymentStatus @default(CREATED)
  checkoutUrl String?       @db.VarChar(500)
  paidAt      DateTime?
  failureCode String?       @db.VarChar(100)
  raw         Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([provider, providerRef])
  @@index([orderId])
  @@index([status, createdAt])
}

/// Every gateway callback, valid or not, for debugging and replay safety.
model PaymentWebhookLog {
  id             BigInt    @id @default(autoincrement())
  provider       String    @db.VarChar(30)
  providerRef    String?   @db.VarChar(100)
  signatureValid Boolean
  payload        Json
  processedAt    DateTime?
  error          String?   @db.Text
  createdAt      DateTime  @default(now())

  @@index([provider, providerRef])
}

/// One row per reminder sent, so the daily job never sends the same reminder twice.
model MembershipReminder {
  id           BigInt   @id @default(autoincrement())
  membershipId BigInt
  offsetDays   Int // positive = days before expiry, negative = days after
  sentAt       DateTime @default(now())

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Restrict)

  @@unique([membershipId, offsetDays])
}
